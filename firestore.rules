rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin comes ONLY from users/{uid}.role == 'admin'.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isClinician() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'clinician';
    }

    function isLinkedPatient(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/patients/$(patientId)) &&
        get(/databases/$(database)/documents/patients/$(patientId)).data.linkedUserId == request.auth.uid;
    }

    // Single source of truth for membership: care_teams/{patientId}_{uid}.
    function isActiveCareTeamMember(patientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/care_teams/$(patientId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/care_teams/$(patientId + '_' + request.auth.uid)).data.status == 'active';
    }

    function isActiveClinicianOnTeam(patientId) {
      return isClinician() && isActiveCareTeamMember(patientId);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      // Staff profiles are readable by any signed-in user, so a patient can see
      // who is on their care team. Patient and admin records: self and admin only.
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.role in ['clinician', 'nurse']);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId && onlyChanges(['displayName', 'phone']));
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow get: if isAdmin() ||
        isActiveCareTeamMember(patientId) ||
        (isAuthenticated() && resource.data.linkedUserId == request.auth.uid);

      allow list: if isAdmin();

      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'id', 'mrn', 'firstName', 'lastName', 'dob', 'gender', 'email', 'phone', 'linkedUserId', 'createdAt'
        ]);

      // Identity fields (mrn, name, dob, linkedUserId) change only through admin.
      // linkedUserId is an access grant, so no one else may touch it.
      allow update: if isAdmin() ||
        ((isActiveCareTeamMember(patientId) ||
          (isAuthenticated() && resource.data.linkedUserId == request.auth.uid)) &&
         onlyChanges(['phone', 'email']));

      allow delete: if false;

      match /notes/{noteId} {
        allow read: if isActiveCareTeamMember(patientId) || isLinkedPatient(patientId);
        allow create: if isActiveCareTeamMember(patientId) &&
                      request.resource.data.authorId == request.auth.uid;
        allow update: if resource.data.authorId == request.auth.uid &&
                         isActiveCareTeamMember(patientId) &&
                         request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }

      match /vitals/{vitalId} {
        allow read: if isActiveCareTeamMember(patientId) || isLinkedPatient(patientId);
        allow create: if (isLinkedPatient(patientId) &&
                          request.resource.data.source == 'patient' &&
                          request.resource.data.authorId == request.auth.uid) ||
                         (isActiveCareTeamMember(patientId) &&
                          request.resource.data.source == 'clinic' &&
                          request.resource.data.authorId == request.auth.uid);
        // Author only, still active; author and source can never change.
        allow update: if resource.data.authorId == request.auth.uid &&
                         isActiveCareTeamMember(patientId) &&
                         request.resource.data.authorId == resource.data.authorId &&
                         request.resource.data.source == resource.data.source;
        allow delete: if false;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isActiveCareTeamMember(patientId) || isLinkedPatient(patientId);
        allow create: if isActiveClinicianOnTeam(patientId) &&
                      request.resource.data.authorId == request.auth.uid;
        allow update: if isActiveClinicianOnTeam(patientId) &&
                         request.resource.data.authorId == resource.data.authorId;
        allow delete: if false;
      }
    }

    match /care_teams/{teamMemberId} {
      // Members can always see their own entries (their patient list). Active
      // team members and the linked patient can see the whole team.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isActiveCareTeamMember(resource.data.patientId) ||
        isLinkedPatient(resource.data.patientId));

      // The document ID is what grants access, so it must equal
      // {patientId}_{userId}. Role must match the user's real role.
      allow create: if (isAdmin() || isActiveClinicianOnTeam(request.resource.data.patientId)) &&
        teamMemberId == request.resource.data.patientId + '_' + request.resource.data.userId &&
        request.resource.data.status == 'active' &&
        request.resource.data.role in ['clinician', 'nurse'] &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role == request.resource.data.role;

      // Removal only, keeping history. Admin or an active clinician on the team;
      // nurses cannot remove anyone. patientId and userId never change.
      allow update: if request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.userId == resource.data.userId &&
        (isAdmin() ||
         (isActiveClinicianOnTeam(resource.data.patientId) &&
          onlyChanges(['status', 'removedAt']) &&
          request.resource.data.status == 'removed'));

      allow delete: if false;
    }
  }
}
